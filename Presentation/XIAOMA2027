<script>
let cur = 0;
const TOTAL = 8;
const slides = document.querySelectorAll('.slide');

function scaleStage() {
  const aw = window.innerWidth, ah = window.innerHeight - 46;
  const scale = Math.min(aw / 1280, ah / 720);
  const sw = 1280 * scale, sh = 720 * scale;
  const st = document.getElementById('stage');
  st.style.transform = `scale(${scale})`;
  st.style.left = ((aw - sw) / 2) + 'px';
  st.style.top = Math.max(0, (ah - sh) / 2) + 'px';
}

function updateUI() {
  document.getElementById('sctr').textContent = (cur + 1) + ' / ' + TOTAL;
  document.getElementById('prevBtn').disabled = cur === 0;
  document.getElementById('nextBtn').disabled = cur === TOTAL - 1;
  document.getElementById('stbar').textContent = slides[cur].dataset.title || '';
  document.getElementById('prog').style.width = ((cur + 1) / TOTAL * 100) + '%';
}

function go(dir) {
  const n = cur + dir;
  if (n < 0 || n >= TOTAL) return;
  slides[cur].classList.remove('active');
  slides[cur].classList.add('exiting');
  const prev = cur;
  setTimeout(() => slides[prev].classList.remove('exiting'), 420);
  cur = n;
  slides[cur].classList.add('active');
  updateUI();
}

document.addEventListener('keydown', e => {
  if (['ArrowRight', 'ArrowDown', 'Space'].includes(e.code)) { e.preventDefault(); go(1); }
  if (['ArrowLeft', 'ArrowUp'].includes(e.code)) { e.preventDefault(); go(-1); }
});

// PDF Export
async function exportPDF() {
  const btn = document.getElementById('pdfBtn');
  btn.textContent = '⏳'; btn.disabled = true;
  try {
    const { jsPDF } = window.jspdf;
    if (!jsPDF) throw new Error('jsPDF not loaded');
    const pdf = new jsPDF({ orientation: 'landscape', unit: 'px', format: [1280, 720] });
    const st = document.getElementById('stage');
    const origT = st.style.transform, origL = st.style.left, origTop = st.style.top;
    st.style.transform = 'none'; st.style.left = '0'; st.style.top = '0';
    const saved = cur;
    for (let i = 0; i < TOTAL; i++) {
      slides.forEach((s, idx) => { s.style.cssText += (idx === i ? ';opacity:1!important;transform:none!important;z-index:1' : ';opacity:0!important;z-index:0'); });
      await new Promise(r => setTimeout(r, 250));
      const canvas = await html2canvas(st, { scale: 1, useCORS: true, allowTaint: true, logging: false });
      const img = canvas.toDataURL('image/jpeg', 0.92);
      if (i > 0) pdf.addPage([1280, 720], 'landscape');
      pdf.addImage(img, 'JPEG', 0, 0, 1280, 720);
    }
    slides.forEach((s, idx) => { s.style.cssText = s.style.cssText.replace(/;opacity[^;]*!important/g, '').replace(/;transform[^;]*!important/g, '').replace(/;z-index[^;]*/g, ''); if (idx === saved) s.classList.add('active'); else s.classList.remove('active'); });
    st.style.transform = origT; st.style.left = origL; st.style.top = origTop;
    cur = saved; updateUI();
    pdf.save('XIAOMA_2027_Marketing_Plan.pdf');
  } catch(e) { console.error(e); window.print(); }
  btn.textContent = '↓ PDF'; btn.disabled = false;
}

// PPTX Export
async function exportPPTX() {
  const btn = document.getElementById('pptxBtn');
  btn.textContent = '⏳'; btn.disabled = true;
  try {
    if (typeof PptxGenJS === 'undefined') throw new Error('PptxGenJS not loaded');
    const pptx = new PptxGenJS();
    pptx.layout = 'LAYOUT_WIDE';
    pptx.title = 'XIAOMA 2027 全球整合營銷方案';
    pptx.author = 'Tabris Yuen';
    const st = document.getElementById('stage');
    const origT = st.style.transform, origL = st.style.left, origTop = st.style.top;
    st.style.transform = 'none'; st.style.left = '0'; st.style.top = '0';
    const saved = cur;
    for (let i = 0; i < TOTAL; i++) {
      slides.forEach((s, idx) => { s.style.cssText += (idx === i ? ';opacity:1!important;transform:none!important;z-index:1' : ';opacity:0!important;z-index:0'); });
      await new Promise(r => setTimeout(r, 280));
      const canvas = await html2canvas(st, { scale: 1, useCORS: true, logging: false });
      const img = canvas.toDataURL('image/png');
      const slide = pptx.addSlide();
      slide.addImage({ data: img, x: 0, y: 0, w: '100%', h: '100%' });
    }
    slides.forEach((s, idx) => { s.style.cssText = s.style.cssText.replace(/;opacity[^;]*!important/g, '').replace(/;transform[^;]*!important/g, '').replace(/;z-index[^;]*/g, ''); if (idx === saved) s.classList.add('active'); else s.classList.remove('active'); });
    st.style.transform = origT; st.style.left = origL; st.style.top = origTop;
    cur = saved; updateUI();
    await pptx.writeFile({ fileName: 'XIAOMA_2027_Marketing_Plan.pptx' });
  } catch(e) { console.error(e); }
  btn.textContent = '↓ PPTX'; btn.disabled = false;
}

scaleStage();
